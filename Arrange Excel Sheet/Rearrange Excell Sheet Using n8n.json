    {
      "parameters": {
        "jsCode": "const items = $input.all();\nreturn items.map((item, i) => {\n  const j = item.json;\n  return { json: {\n    'Customer ID': 'CUST-' + String(i + 1).padStart(4, '0'),\n    'Full Name': j['Full Name'],\n    'Email Address': j['Email Address'],\n    'Phone Number': j['Phone Number'],\n    'Address': j['Address'],\n    ...( 'City' in j ? { 'City': j['City'] } : {} ),\n    ...( 'Date' in j ? { 'Date': j['Date'] } : {} ),\n  }};\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1792,
        -192
      ],
      "id": "fe0e1f38-7265-415d-8248-6cbb1d785e64",
      "name": "customer id"
    },
    {
      "parameters": {
        "jsCode": "for (const item of $input.all()) {\n    if (item.json.Date) {\n        let d = item.json.Date;\n        let parsed = new Date(d.includes('/') ? d.split('/').reverse().join('-') : d);\n        if (!isNaN(parsed.getTime())) {\n            item.json.Date = parsed.toISOString().split('T')[0];\n        }\n    }\n}\nreturn $input.all();"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1120,
        -192
      ],
      "id": "18eef27e-d721-4e0b-b81a-79a3e008af68",
      "name": "invalid date"
    },
    {
      "parameters": {
        "jsCode": "// ---- node names exactly as on your canvas ----\nconst N_IMPORT   = 'Extract from File';\nconst N_EMPTY    = 'remove empty cell';\nconst N_CLEAN    = 'Check space & capatialize';\nconst N_VALID    = 'invalid email,number';\nconst N_DATE     = 'invalid date';\nconst N_DUP_MAIL = 'duplicate email';\nconst N_DUP_NUM  = 'duplicate number';\nconst N_FINAL    = 'customer id';\n\nconst count = name => $(name).all().length;\n\nconst imported     = count(N_IMPORT);\nconst afterEmpty   = count(N_EMPTY);\nconst afterValid   = count(N_VALID);\nconst afterDate    = count(N_DATE);\nconst afterDupMail = count(N_DUP_MAIL);\nconst afterDupNum  = count(N_DUP_NUM);\nconst finalCount   = count(N_FINAL);\n\n// Count invalid emails and phones from the cleaned rows\nconst emailRe = /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/;\nconst phoneRe = /^01\\d{9}$/;\n\nlet badEmail = 0, badPhone = 0;\nfor (const it of $(N_CLEAN).all()) {\n  const j = it.json;\n  const email = String(j['Email Address'] ?? j['Email'] ?? '').trim();\n  const phone = String(j['Phone Number'] ?? j['Phone'] ?? '').replace(/[\\s\\-]/g, '');\n  if (!emailRe.test(email)) badEmail++;\n  else if (!phoneRe.test(phone)) badPhone++;\n}\n\nconst emptyRemoved = imported - afterEmpty;\nconst dups = (afterDate - afterDupMail) + (afterDupMail - afterDupNum);\n\nconst rows = [\n  { Metric: 'Total Rows Imported',          Count: imported },\n  { Metric: 'Rows Removed (Empty/Invalid)', Count: emptyRemoved + badEmail + badPhone },\n  { Metric: 'Duplicate Rows Removed',       Count: dups },\n  { Metric: 'Invalid Emails Removed',       Count: badEmail },\n  { Metric: 'Invalid Phones Removed',       Count: badPhone },\n  { Metric: 'Final Row Count',              Count: finalCount },\n];\n\nreturn rows.map(r => ({ json: r }));"
      },
